# ============================================================
#  数据库账号密码模板
#  用法：把本文件复制成同目录下的 db.properties，再填你自己的账号密码
#       （Windows: copy db.properties.example db.properties）
#  db.properties 已在 .gitignore 中排除，不会被提交到仓库。
#
#  只有账号密码放这里。数据库地址、库名在 mybatis-config.xml 里。
# ============================================================

db.username=root
db.password=改成你自己的密码
